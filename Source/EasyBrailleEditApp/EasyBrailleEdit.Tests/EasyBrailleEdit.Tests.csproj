<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.*" />
	<PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- STA / WPF / WinForms 測試支援（對應 xUnit v3 的版本） -->
    <PackageReference Include="Xunit.StaFact" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyBrailleEdit\EasyBrailleEdit.csproj" />
    <ProjectReference Include="..\BrailleToolkit\BrailleToolkit.csproj" />
    <ProjectReference Include="..\Txt2Brl\Txt2Brl.csproj" />
  </ItemGroup>

</Project>
