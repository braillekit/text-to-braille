<?xml version="1.0" encoding="utf-8"?>
<Symbols>
  <!-- 在數學區塊裡面，有些標點符號的點字跟一般文字的點字不同。 -->
  <!-- 在這裡定義全形空白是為了比 TwChineseCharConverter 搶先一步抓到空白。因為
       TwChineseCharConverter 若碰到空白，處理完之後就會緊接著把後續的文字與標點符號
       一併處理掉，使得 MathConverter 沒機會處理這些特殊的標點符號。 -->
  <symbol text="　"     dots=" "     type="Misc" description="全形空白" />
  <symbol text="("     dots="12356"    type="Math" Description="數學半形左括弧" />
  <symbol text=")"     dots="23456"    type="Math" Description="數學半形左括弧" />
  <symbol text="（"     dots="12356"    type="Math" Description="數學全形左括弧" />
  <symbol text="）"     dots="23456"    type="Math" Description="數學全形左括弧" />
  <symbol text=","     dots="6"    type="Math" Description="半形逗號，第 6 點" />
  <symbol text="，"     dots="6"    type="Math" Description="全形逗號，第 6 點" />
  <symbol text="；"     dots="456 23"  type="Math" Description="全形分號" />
  <symbol text="。"     dots="456 256"  type="Math" Description="全形句號" />
  <symbol text="："     dots="456 25"  type="Math" Description="全形冒號" />
  <symbol text="…"     dots="3 3 3" type="Punctuation" description="刪節號" />
  <symbol text="？"     dots="456 236"  type="Punctuation" description="問號" />
  <symbol text="「"     dots="236"    type="Math" Description="數學上引號" />
  <symbol text="」"     dots="456 356"  type="Math" Description="數學下引號" />
  <symbol text="╳"     dots="1346"    type="Math" Description="打叉" />
  <symbol text="○"     dots="135"    type="Math" Description="打圈" />
  <symbol text="√"     dots="26 345"   type="Misc" description="打勾（注意: 為了避免跟注音符號的第三聲一樣，故改用根號符號）" />   
  
  <!-- 數學符號 -->
  <symbol text="+"     dots="346"     type="Math" Description="加號" />
  <symbol text="-"     dots="36"     type="Math" Description="減號" />
  <symbol text="*"     dots="4 16"   type="Math" Description="乘號" />
  <symbol text="/"     dots="46 34"   type="Math" Description="除號" />
  <symbol text="^"     dots="45"     type="Math" Description="次方" />
  <symbol text="."     dots="46"     type="Math" Description="小數點" />
  <symbol text=":"     dots="25"     type="Math" Description="幾比幾" />
  <!-- 下面的乘號和除號必須用支援 unicode 的編輯器才能正確顯示 -->  
  <symbol text="×"     dots="4 16"   type="Math" Description="乘號" />  
  <symbol text="÷"     dots="46 34"   type="Math" Description="除號" />  
  <symbol text="="     dots="46 13"   type="Math" Description="等於" />
</Symbols>