<?xml version="1.0" encoding="utf-8"?>
<Symbols>
  <!-- 在數學區塊裡面，有些標點符號的點字跟一般文字的點字不同。 -->
  <!-- 在這裡定義全形空白是為了比 TwChineseCharConverter 搶先一步抓到空白。因為
       TwChineseCharConverter 若碰到空白，處理完之後就會緊接著把後續的文字與標點符號
       一併處理掉，使得 MathConverter 沒機會處理這些特殊的標點符號。 -->
  <symbol text="　"    code="00" dots=" "     type="Misc" description="全形空白" />
  <symbol text="("    code="37" dots="12356"    type="Math" Description="數學半形左括弧" />
  <symbol text=")"    code="3E" dots="23456"    type="Math" Description="數學半形左括弧" />
  <symbol text="（"    code="37" dots="12356"    type="Math" Description="數學全形左括弧" />
  <symbol text="）"    code="3E" dots="23456"    type="Math" Description="數學全形左括弧" />
  <symbol text=","    code="20" dots="6"    type="Math" Description="半形逗號，第 6 點" />
  <symbol text="，"    code="20" dots="6"    type="Math" Description="全形逗號，第 6 點" />
  <symbol text="；"    code="3806" dots="456 23"  type="Math" Description="全形分號" />
  <symbol text="。"    code="3832" dots="456 256"  type="Math" Description="全形句號" />
  <symbol text="："    code="3812" dots="456 25"  type="Math" Description="全形冒號" />
  <symbol text="…"    code="040404" dots="3 3 3" type="Punctuation" description="刪節號" />
  <symbol text="？"    code="3826" dots="456 236"  type="Punctuation" description="問號" />
  <symbol text="「"    code="26" dots="236"    type="Math" Description="數學上引號" />
  <symbol text="」"    code="3834" dots="456 356"  type="Math" Description="數學下引號" />
  <symbol text="╳"    code="2D" dots="1346"    type="Math" Description="打叉" />
  <symbol text="○"    code="15" dots="135"    type="Math" Description="打圈" />
  <symbol text="√"    code="221C" dots="26 345"   type="Misc" description="打勾（注意: 為了避免跟注音符號的第三聲一樣，故改用根號符號）" />   
  
  <!-- 數學符號 -->
  <symbol text="+"    code="2C" dots="346"     type="Math" Description="加號" />
  <symbol text="-"    code="24" dots="36"     type="Math" Description="減號" />
  <symbol text="*"    code="0821" dots="4 16"   type="Math" Description="乘號" />
  <symbol text="/"    code="280C" dots="46 34"   type="Math" Description="除號" />
  <symbol text="^"    code="18" dots="45"     type="Math" Description="次方" />
  <symbol text="."    code="28" dots="46"     type="Math" Description="小數點" />
  <symbol text=":"    code="12" dots="25"     type="Math" Description="幾比幾" />
  <!-- 下面的乘號和除號必須用支援 unicode 的編輯器才能正確顯示 -->  
  <symbol text="×"    code="0821" dots="4 16"   type="Math" Description="乘號" />  
  <symbol text="÷"    code="280C" dots="46 34"   type="Math" Description="除號" />  
  <symbol text="="    code="2805" dots="46 13"   type="Math" Description="等於" />
</Symbols>